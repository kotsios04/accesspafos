# ---------------------------------------------------------------------------
# AccessPafos AI - example environment file
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Firebase Web SDK config (public by design, safe to ship in the bundle) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Cloud Functions region (must match functions deployment region) ---
VITE_FUNCTIONS_REGION=europe-west1

# --- Map basemap style (OpenFreeMap by default; see docs/DATA_SOURCES_AND_ATTRIBUTION.md) ---
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Feature flags ---
# DEMO_MODE renders clearly-labelled fixture data. MUST be false in production.
VITE_DEMO_MODE=false
VITE_ANALYTICS_ENABLED=false

# --- Emulators (local development) ---
VITE_USE_EMULATORS=false

# ===========================================================================
# SERVER-SIDE ONLY. These are NOT prefixed with VITE_ and never reach the
# browser bundle. In production they are stored in Google Secret Manager and
# bound to the Cloud Functions via defineSecret(). See docs/DEPLOYMENT.md.
# ===========================================================================

# Mapillary API v4 access token (https://www.mapillary.com/dashboard/developers)
MAPILLARY_ACCESS_TOKEN=

# Gemini API key for Genkit (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the Overpass API endpoint used for OSM ingestion
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Optional: contact e-mail sent in the User-Agent to Overpass / Nominatim,
# as required by their usage policies.
OSM_CONTACT_EMAIL=

# Used by scripts/set-admin.js and scripts/import-region.js (local admin CLI).
# Path to a service account JSON key, or leave blank to use ADC
# (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Same Mapillary token, exposed to the browser so the segment detail can show
# the photograph an assessment was based on. Vite only inlines VITE_* names.
VITE_MAPILLARY_TOKEN=
